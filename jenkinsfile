pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/vaishnavigulhane19/jenkins-practice.git'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    mvn clean package
                    echo "build is successful"
                '''
            }
        }

        stage('Artifact to S3') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-access']
                ]) {
                    sh '''
                        aws s3 cp target/student-management.war s3://deploywithnavi.space/Artifact/student.war
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                // your existing SonarQube commands
            }
        }
    }
}