pipeline {
    agent {
        label 'worker'
    }
    tools {
        maven 'maven'
    }
    stages {
        stage ('checkout') {
            steps {
                git 'https://github.com/mayurpandit25/student-management.git'
                sh '''
                echo "hello jenkins"
                '''
            }
        }

        stage ('Build') {
            steps {
                sh '''
                mvn clean package 
                echo " build is successfull"
                '''
            }
        }

        post {
            success {
                archiveArtifacts artifacts: '***/target/*.jar', fingerprint: true
            }
        }

    }
}