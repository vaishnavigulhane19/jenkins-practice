pipeline {
    agent {
        label 'worker'
    }

    environment {
        my_aws_credentials = credentials('aws_access')
    }

    tools {
        maven 'maven'
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/mayurpandit25/student-management.git'

                sh '''
                    echo "hello jenkins"
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    mvn clean package
                    echo "build is successful"
                '''
            }
        }

        stage('Artifact to S3') {
            steps {
                sh '''
                    aws s3 cp target/*.war s3://deploywithnavi.space/Artifact/student.war
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                sh '''
                    mvn sonar:sonar
                '''
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'target/*.war', fingerprint: true
        }
    }
}

