pipeline {
    agent {
        label "worker"
    }

    environment {
        my_aws_credentials = credentials('ad9c1fb8-1fbe-47a4-bf9f-126ac68e879c')
    }

    tools {
        maven "maven"
    }

    stages {
        stage('checkout'){
            steps {
                git 'https://github.com/mayurpandit25/student-management.git'
                sh '''
                echo "clonning is successful"
                '''
            }
        }

        stage('Build'){
            steps {
                sh '''
                mvn clean package
                echo "build is successful"
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifact to S3'){
            steps {
                sh '''
                aws s3 cp target/*.war s3://deploywithnavi.space/Artifact/student.war
                '''
            }
        }

        // stage('SonarQube Analysis'){
        //     steps {
        //         withSonarQubeEnv('sonar') {
        //           sh 'mvn sonar:sonar'
        //         } 
        //     }
        // }
    }
}
